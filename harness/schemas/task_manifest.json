{
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "task_id": {
      "minLength": 1,
      "title": "Task Id",
      "type": "string"
    },
    "dispatch_id": {
      "minLength": 1,
      "title": "Dispatch Id",
      "type": "string"
    },
    "role": {
      "enum": [
        "builder",
        "reviewer",
        "verifier"
      ],
      "title": "Role",
      "type": "string"
    },
    "base_sha": {
      "pattern": "^[a-f0-9]{40}$",
