    },
    "payload_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Payload Sha256",
      "type": "string"
    },
    "status": {
      "enum": [
        "reported",
        "blocked"
      ],
      "title": "Status",
      "type": "string"
    },
    "completion_evidence": {
      "additionalProperties": {
        "pattern": "^[a-f0-9]{64}$",
