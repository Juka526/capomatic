      "type": "string"
    },
    "input_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Input Sha256",
      "type": "string"
    },
    "output_hashes": {
      "additionalProperties": {
        "pattern": "^[a-f0-9]{64}$",
