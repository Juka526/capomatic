# PaddleOCR
PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True

# Browser origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Offline development utilities only; paid/provider OCR is excluded from V1.
# GEMINI_API_KEY=your-gemini-key
# ANTHROPIC_API_KEY=your-anthropic-key

# Auth0 API token verification (V1 login; no database required)
# AUTH0_DOMAIN=your-domain.auth0.com
# AUTH0_AUDIENCE=https://capomatic-api

# Backend error tracking (required for the V1 production deployment)
# SENTRY_DSN=https://public-key@o0.ingest.sentry.io/project-id
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=capomatic@1.0.0
