{
  "name": "capomatic-frontend",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "check": "npm run test && npm run typecheck && npm run build",
    "dev:toss": "NEXT_PUBLIC_APP_TARGET=toss next dev --webpack",
    "build:toss": "npm run export:toss && ait build",
    "export:toss": "NEXT_PUBLIC_APP_TARGET=toss next build --webpack && node scripts/check-toss-export.mjs",
    "check:toss": "NEXT_PUBLIC_APP_TARGET=toss npm run check && node scripts/check-toss-export.mjs && ait build"
  },
  "dependencies": {
    "@apps-in-toss/web-framework": "^3.7.0",
    "@auth0/auth0-spa-js": "^2.18.0",
    "@sentry/nextjs": "10.74.0",
    "@vercel/analytics": "^2.0.1",
    "lucide-react": "^0.468.0",
    "next": "^16.3.8",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.0.0",
    "@apps-in-toss/devtools": "^3.7.0"
  }
}
